# Copie ces variables dans Render > Environment (ne mets JAMAIS de vraies valeurs sur GitHub)

# URL de ton fournisseur de check. {number} sera remplace par le numero (chiffres seulement).
CHECK_API_URL=https://ton-fournisseur.example/api/check?number={number}
CHECK_API_KEY=
CHECK_API_KEY_HEADER=Authorization

# --- Noms des champs JSON de la reponse du fournisseur (valeurs par defaut ci-dessous) ---
# Seul BANNED_FIELD est obligatoire (true = banni, false = pas banni).
# Les autres alimentent le tableau de details; s'ils manquent, la page affiche "-".
BANNED_FIELD=banned
TYPE_FIELD=ban_type
VIOLATION_FIELD=violation
CATEGORY_FIELD=category
APPEAL_FIELD=appeal
EU_FIELD=eu
BANNED_AT_FIELD=banned_at
APPEAL_FILED_FIELD=appeal_filed

# Duree du ban, pour distinguer un ban court (ex: 24h) d'un ban de 3 mois.
# Soit un nombre d'heures (DURATION_HOURS_FIELD), soit une date de fin (BANNED_UNTIL_FIELD) avec BANNED_AT_FIELD.
DURATION_HOURS_FIELD=duration_hours
BANNED_UNTIL_FIELD=banned_until

# Un ban de cette duree ou plus s'affiche "ban permanent" (3 mois ~ 90 jours; 80 par defaut)
PERMANENT_AFTER_DAYS=80